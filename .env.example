# LLM Provider: google, anthropic, or openai
# If GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY is present, provider defaults to google.
LLM_PROVIDER=google

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
# Either GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY is supported.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Models (defaults to gemini-2.0-flash for both cheap and capable tiers)
# LLM_MODEL_CHEAP=gemini-2.0-flash
# LLM_MODEL_CAPABLE=gemini-2.0-flash

# Optional: Other providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Fine-tuning retry & timeout settings
# LLM_API_RETRIES=5
# LLM_RETRY_BASE_MS=2000
# LLM_REQUEST_TIMEOUT_MS=90000
# LLM_TIMEOUT_MS=240000

