{
  "name": "autorefactor-ai",
  "version": "0.1.0",
  "description": "Token-efficient agentic refactoring CLI: parses legacy JS/TS, plans fixes by dependency order and priority, asks an LLM for minimal patches, verifies them, and commits each verified fix.",
  "type": "module",
  "bin": {
    "autorefactor": "dist/bin/autorefactor.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "keywords": [
    "refactoring",
    "llm",
    "ai",
    "cli",
    "javascript",
    "typescript",
    "ast",
    "tokens",
    "code-quality"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx bin/autorefactor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "tsx scripts/inspectPipeline.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "demo:reset": "tsx scripts/resetDemo.ts"
  },
  "dependencies": {
    "ts-morph": "^23.0.0",
    "ai": "^4.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "zod": "^3.23.8",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "simple-git": "^3.27.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.10.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.1",
    "@types/node": "^22.5.5",
    "typescript": "^5.5.4"
  }
}